{
  "name": "wenforge-studio",
  "version": "0.1.0",
  "description": "Local-first desktop studio for Chinese web novel generation.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:native:electron && electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm rebuild:native:node && vitest run",
    "test:watch": "vitest",
    "test:smoke": "pnpm rebuild:native:electron && playwright test",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "dev:import-env-credentials": "electron scripts/dev-import-env-credentials.mjs",
    "providers:smoke": "tsx scripts/providers-smoke.ts",
    "providers:report": "tsx scripts/providers-report.ts",
    "package": "pnpm build && electron-builder --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "release:dry-run": "pnpm build && electron-builder --dir --publish never",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "build": {
    "appId": "studio.wenforge.app",
    "productName": "WenForge Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "skills/wenforge-webnovel-writer/**",
      "package.json",
      "!references/**",
      "!references/repos/**",
      "!docs/**",
      "!test-results/**",
      "!tests/**",
      "!src/**",
      "!**/*.tsbuildinfo"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  }
}
