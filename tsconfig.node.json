{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vitest"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/db/**/*.ts",
    "src/ai/**/*.ts",
    "src/agents/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
