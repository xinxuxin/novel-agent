{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenforge.local/schemas/revision-plan.schema.json",
  "title": "RevisionPlan",
  "type": "object",
  "required": ["changes", "human_review_needed"],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_section", "reason", "repair_strategy"],
        "properties": {
          "target_section": { "type": "string" },
          "reason": { "type": "string" },
          "repair_strategy": { "type": "string" },
          "expected_effect": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "human_review_needed": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
